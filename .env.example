# NOVAX Admin / Serverless API
# Never commit real values.

# Neon pooled PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Random secret, minimum 32 characters, used to sign admin session cookies
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Travelpayouts is intentionally disabled until real API credentials exist
TRAVELPAYOUTS_ENABLED=false
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_MARKER=
